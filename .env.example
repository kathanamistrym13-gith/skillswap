# MongoDB Database Connection URI (Required for Vercel / Production)
# Get a free cloud database URI from MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillswap?retryWrites=true&w=majority

# Google Gemini API Key for AI Features (Roadmap generator, Practice Simulator, Career Copilot, AI Notetaker)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Dedicated WebSockets Server URL for Live Video Signaling and Real-Time Chat (if hosted on Render/Railway/Fly.io)
# VITE_SOCKET_URL=https://your-skillswap-socket-server.onrender.com
